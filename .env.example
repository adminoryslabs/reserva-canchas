# Neon: URL con pooler (runtime) y URL directa (solo migraciones). Ver ADR-0006.
# En local ambas apuntan al Postgres de docker-compose.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reservas"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/reservas"

# Vista de administrador (ADR-0009). Ambas son requeridas: si falta alguna, /admin responde 503.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# Rate limiting (ADR-0010)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Solo desarrollo/pruebas: desactiva el rate limiting. Se ignora si NODE_ENV=production.
RATE_LIMIT_DISABLED=""

# Zona para calcular "hoy" (identificador IANA). Zona real del complejo: Punto Abierto.
COMPLEX_TIMEZONE="UTC"
